# OpenWeather API key: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key

# Key that clients must send in the x-api-key header to call POST /scraper
INTERNAL_API_KEY=replace_with_a_long_random_string

# Login for the Streamlit app
STREAMLIT_USERNAME=your_username
STREAMLIT_PASSWORD=replace_with_a_strong_password
